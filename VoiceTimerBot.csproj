<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Native/libdave.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>libdave.so</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3"/>
        <PackageReference Include="NetCord" Version="1.0.0-alpha.468"/>
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-alpha.468"/>
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-alpha.468"/>
        <PackageReference Include="NetCord.Services" Version="1.0.0-alpha.468"/>
        <PackageReference Include="Sentry" Version="6.1.0" />
        <PackageReference Include="Sentry.Extensions.Logging" Version="6.1.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <UsingTask TaskName="VerifyVoiceClips"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <AppSettingsPath ParameterType="System.String" Required="true" />
            <BaseDir ParameterType="System.String" Required="true" />
            <Missing ParameterType="System.String" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                    var keys = new[] { "StartClipPath", "Warn60s", "Warn40s", "Warn20s", "MaiJungle", "ZealClipPath", "FirstBossClipPath", "SecondBossClipPath" };
                    var pattern = "\"(" + string.Join("|", keys) + ")\"\\s*:\\s*\"([^\"]+)\"";
                    var json = File.ReadAllText(AppSettingsPath);
                    var missing = new List<string>();
                    foreach (Match m in Regex.Matches(json, pattern))
                    {
                        var key = m.Groups[1].Value;
                        var rel = m.Groups[2].Value;
                        var resolved = Path.IsPathRooted(rel) ? rel : Path.Combine(BaseDir, rel);
                        if (!File.Exists(resolved))
                            missing.Add(key + "=\"" + rel + "\"");
                    }
                    Missing = string.Join("; ", missing);
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="VerifyVoiceClipsExist"
            BeforeTargets="Build"
            Condition="Exists('$(MSBuildProjectDirectory)\appsettings.json')">
        <VerifyVoiceClips AppSettingsPath="$(MSBuildProjectDirectory)\appsettings.json"
                          BaseDir="$(MSBuildProjectDirectory)">
            <Output TaskParameter="Missing" PropertyName="_MissingVoiceClips" />
        </VerifyVoiceClips>
        <Error Condition="'$(_MissingVoiceClips)' != ''"
               Text="Voice clip(s) referenced in appsettings.json do not exist on disk: $(_MissingVoiceClips)" />
    </Target>

</Project>
